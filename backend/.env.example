# ============================================
# Variables de entorno — copiar a backend/.env
# ============================================

DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

HOST=0.0.0.0
PORT=3000
# IP que se muestra como enlace LAN (opcional; si vacío, se detecta automáticamente)
LAN_IP=

# URL del frontend (CORS en backend)
FRONTEND_URL=http://localhost:5173

# Autenticación por roles (AUTH_ENABLED=false desactiva login en desarrollo)
AUTH_ENABLED=true
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Formato: usuario:contraseña:rol;usuario:contraseña:rol
# Roles: administracion | direccion | gerencia_comercial | contabilidad
AUTH_USERS=admin:Admin2026!:administracion;gerente.general:GgVECSA2026!:direccion;direccion:Direccion2026!:direccion;contraloria:Contraloria2026!:contabilidad;contabilidad:Conta2026!:contabilidad;gerencia:Comercial2026!:gerencia_comercial;comercial:Comercial2026!:gerencia_comercial

NETWORK_USER=
NETWORK_PASSWORD=
APP_USER=
APP_PASSWORD=
EMAIL_USER=
EMAIL_PASSWORD=
API_KEY=
API_SECRET=

# OpenAI — Asistente IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sync Google Sheets CRM (leads / solicitudes / tráfico / F&I / pagos GMF / CSI).
# Horarios (America/Mexico_City). Acepta "10" (=10:00) o "19:50".
# 19:50 = carga completa de todas las fuentes del reporte Objetivos Web + push a cloud.
CRM_SHEETS_SYNC_ENABLED=true
CRM_SHEETS_SYNC_AT=10,16,18,19:50
CRM_SHEETS_SYNC_TZ=America/Mexico_City
# false = no sincroniza al arrancar el backend
CRM_SHEETS_SYNC_ON_START=false
# Opcional: URL de export xlsx y ruta local del archivo
# CRM_SHEETS_URL=https://docs.google.com/spreadsheets/d/1d-cqASV5c6BmlAhQTnTvxZ7H6GsT1-M6FjLzI-Q2JE0/export?format=xlsx
# CRM_SHEETS_XLSX=

# Sync a API en la nube (PostgreSQL) — TODOS los dominios juntos cada N min
# (overview, ventas, forecast, inventario, contabilidad, crm, postventa, auth)
# Embudo BDC operativo: crm_ciclos en Railway. VECSA Ciclos local = histórico.
# Ingesta incremental CRM → Railway + SQLite (sin borrar histórico):
#   node backend/scripts/ingest-crm-ciclos-railway.js "C:/ruta/VECSA Ciclos.csv"
# Solo local:  ... --local-only   |  Solo Railway: ... --railway-only
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_URL=https://tu-api.ejemplo.com
CLOUD_SYNC_API_KEY=
CLOUD_SYNC_INTERVAL_MINUTES=30
# Objetivos Web en Railway: publicación propia, sin esperar el ciclo de 30 min
CLOUD_SYNC_OBJETIVOS_INTERVAL_MINUTES=2
# true = sync completo ~20s después de arrancar el backend
CLOUD_SYNC_ON_START=false
# CLOUD_SYNC_SOURCE_HOST=nombre-servidor-local
# CLOUD_SYNC_CHUNK_SIZE=300
# CLOUD_SYNC_DAILY_HOUR ya no aplica (postventa va en el mismo ciclo)

# Incadea (SQL Server, solo lectura). No reutilizar el usuario de escritura del DMS.
INCADEA_DB_HOST=
INCADEA_DB_PORT=1433
INCADEA_DB_NAME=
INCADEA_DB_USER=
INCADEA_DB_PASSWORD=
