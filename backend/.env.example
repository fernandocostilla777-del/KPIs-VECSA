# ============================================
# Variables de entorno — copiar a backend/.env
# ============================================

DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=

HOST=0.0.0.0
PORT=3000
# IP que se muestra como enlace LAN (opcional; si vacío, se detecta automáticamente)
LAN_IP=

# URL del frontend (CORS en backend)
FRONTEND_URL=http://localhost:5173

# Autenticación por roles (AUTH_ENABLED=false desactiva login en desarrollo)
AUTH_ENABLED=true
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# Formato: usuario:contraseña:rol;usuario:contraseña:rol
# Roles: administracion | direccion | gerencia_comercial | contabilidad
AUTH_USERS=admin:Admin2026!:administracion;gerente.general:GgBalderrama2026!:direccion;direccion:Direccion2026!:direccion;contraloria:Contraloria2026!:contabilidad;contabilidad:Conta2026!:contabilidad;gerencia:Comercial2026!:gerencia_comercial;comercial:Comercial2026!:gerencia_comercial

NETWORK_USER=
NETWORK_PASSWORD=
APP_USER=
APP_PASSWORD=
EMAIL_USER=
EMAIL_PASSWORD=
API_KEY=
API_SECRET=

# OpenAI — Asistente IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sync Google Sheets CRM (leads / solicitudes / tráfico).
# Además, cada ciclo de cloud-sync (30 min) vuelve a bajar solicitudes y tráfico.
# Reloj extra a las 9:00, 12:00 y 18:00 (hora de México).
CRM_SHEETS_SYNC_ENABLED=true
CRM_SHEETS_SYNC_AT=9,12,18
CRM_SHEETS_SYNC_TZ=America/Mexico_City
# false = no sincroniza al arrancar el backend
CRM_SHEETS_SYNC_ON_START=true
# Opcional: URL de export xlsx y ruta local del archivo
# CRM_SHEETS_URL=https://docs.google.com/spreadsheets/d/1d-cqASV5c6BmlAhQTnTvxZ7H6GsT1-M6FjLzI-Q2JE0/export?format=xlsx
# CRM_SHEETS_XLSX=

# Sync a API en la nube (PostgreSQL) — TODOS los dominios juntos cada N min
# (overview, ventas, forecast, inventario, contabilidad, crm, postventa, auth)
# Embudo BDC operativo: crm_ciclos en Railway. Balderrama Ciclos local = histórico.
# Ingesta incremental CRM → Railway + SQLite (sin borrar histórico):
#   node backend/scripts/ingest-crm-ciclos-railway.js "C:/ruta/Balderrama Ciclos.csv"
# Solo local:  ... --local-only   |  Solo Railway: ... --railway-only
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_URL=https://tu-api.ejemplo.com
CLOUD_SYNC_API_KEY=
CLOUD_SYNC_INTERVAL_MINUTES=30
# true = sync completo ~20s después de arrancar el backend
CLOUD_SYNC_ON_START=false
# CLOUD_SYNC_SOURCE_HOST=nombre-servidor-local
# CLOUD_SYNC_CHUNK_SIZE=300
# CLOUD_SYNC_DAILY_HOUR ya no aplica (postventa va en el mismo ciclo)
