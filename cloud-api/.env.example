# PostgreSQL (Render, Railway, Supabase, Neon, etc.)
DATABASE_URL=postgresql://usuario:password@host:5432/balderrama_cloud

HOST=0.0.0.0
PORT=4000
# NODE_ENV=production

# SSL de PostgreSQL. En producción rejectUnauthorized queda en true.
# Si el proveedor usa certificado no verificable: PG_SSL_REJECT_UNAUTHORIZED=false
# PG_SSL=false
# PG_SSL_REJECT_UNAUTHORIZED=true

# Clave que usa el backend local en header X-API-Key
CLOUD_SYNC_API_KEY=cambiar-por-clave-segura-larga

# Opcional: solo aceptar ingest desde estas IPs de cliente (coma-separadas).
# No uses sourceHost del body: es falsificable. En Railway/proxy, NODE_ENV=production
# activa trust proxy para leer la IP real.
# CLOUD_SYNC_ALLOWED_IPS=189.197.60.78
# CLOUD_SYNC_ALLOWED_SOURCE sigue soportado como alias de esa lista de IPs.

# Acceso de la app móvil.
# Preferido: mismos usuarios del dashboard web vía sync domain=auth (automático).
# Fallback legacy si aún no hay sync:
# Formato: usuario:contraseña:rol;usuario:contraseña:rol
# Roles: administracion | direccion | gerencia_comercial | contabilidad
# MOBILE_AUTH_USERS=usuario:cambiar-contraseña:direccion
MOBILE_AUTH_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Orígenes web adicionales, separados por coma (Capacitor y localhost ya están incluidos)
# MOBILE_ALLOWED_ORIGINS=https://app.ejemplo.com

# Actualizaciones remotas del .exe de escritorio (electron-updater)
# DESKTOP_UPDATES_DIR=/data/desktop-updates

# Asistente IA móvil (datos sync en la nube; respuestas ultra-resumidas por rol)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
